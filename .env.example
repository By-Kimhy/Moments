# PostgreSQL connection string
DATABASE_URL="postgresql://moments:moments@localhost:5432/moments"

# Redis, for OTP codes, rate limits and the notification queue. Leave empty to keep them in
# memory (fine for one API process in development, not for production).
REDIS_URL="redis://localhost:6379"

# Secret used to sign session tokens. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Where the web app finds the API, and the API's own port
API_URL="http://localhost:4000"
API_PORT=4000

# Public address of the web app, used in invitation links
APP_URL="http://localhost:3000"

# Browser origins allowed to call the API directly with cookies (comma-separated)
CORS_ORIGINS="http://localhost:3000"

# Telegram bot (Login widget + host notifications). Create one with @BotFather.
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
# Secret Telegram sends with every webhook call (see README, "Telegram"). Any long random string.
TELEGRAM_WEBHOOK_SECRET=""
# Development without a public URL: "true" makes the API poll Telegram instead of using a webhook.
TELEGRAM_POLLING="false"

# Photos and KHQR images. Without S3_BUCKET they are saved in UPLOAD_DIR (relative to the
# repository root). With it, they go to S3-compatible storage (AWS S3, Cloudflare R2, MinIO);
# S3_ENDPOINT is only needed for R2/MinIO, e.g. https://<account>.r2.cloudflarestorage.com
UPLOAD_DIR="./uploads"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Chromium used to print PDF reports (Khmer needs a real browser to render correctly).
# Leave empty to look in /usr/bin; without one, PDF export answers 503.
CHROMIUM_PATH=""

# Platform fee on ticket sales, in percent (recorded on each order).
PLATFORM_FEE_PERCENT=4

# The platform's own KHQR (PNG or JPEG path), shown to hosts paying for a plan upgrade.
PLATFORM_KHQR_IMAGE=""

# Platform admins (review vendors, confirm plan payments): comma-separated phone numbers.
ADMIN_PHONES=""
