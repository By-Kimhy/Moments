{
  "name": "moments",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "next dev",
    "dev:api": "npm run dev -w server",
    "build": "npm run build -w server && next build",
    "build:web": "next build",
    "start": "concurrently -k -n api,web -c blue,green \"npm:start:api\" \"npm:start:web\"",
    "start:web": "next start",
    "start:api": "npm run start -w server",
    "lint": "eslint",
    "test": "npm test -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "db:seed": "npm run db:seed -w server",
    "typecheck": "next typegen && tsc --noEmit && npm run typecheck -w server"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
