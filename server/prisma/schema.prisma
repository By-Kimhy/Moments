generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  KM
  EN
}

enum EventType {
  WEDDING
  TICKETED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MemberRole {
  OWNER
  HELPER
}

enum Side {
  BRIDE
  GROOM
  BOTH
}

enum RsvpStatus {
  PENDING
  ATTENDING
  DECLINED
}

enum Currency {
  USD
  KHR
}

enum GiftMethod {
  CASH
  KHQR
}

enum GiftStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum GiftSource {
  DESK
  GUEST
  HOST
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum TemplateStyle {
  TRADITIONAL
  MODERN
  MINIMAL
}

model User {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(120)
  phone      String?   @unique @db.VarChar(20) // E.164, e.g. +85512345678
  telegramId BigInt?   @unique
  language   Language  @default(KM)
  isAdmin    Boolean   @default(false) // platform admin: reviews vendors, confirms plan payments
  deletedAt  DateTime? // the person deleted their account: personal details are wiped
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  ownedEvents     Event[]              @relation("EventOwner")
  memberships     EventMember[]
  organizations   OrganizationMember[]
  vendors         Vendor[]
  vendorEnquiries VendorEnquiry[]
  vendorReviews   VendorReview[]
  reports         Report[]
}

model Event {
  id              String      @id @default(uuid()) @db.Uuid
  ownerId         String      @db.Uuid // the account that created (and later pays for) the event
  organizationId  String?     @db.Uuid // a planner's organization running this event
  type            EventType   @default(WEDDING)
  status          EventStatus @default(DRAFT)
  plan            Plan        @default(FREE) // see lib/plans.ts
  titleKm         String      @db.VarChar(200)
  titleEn         String?     @db.VarChar(200)
  brideNameKm     String?     @db.VarChar(120)
  brideNameEn     String?     @db.VarChar(120)
  groomNameKm     String?     @db.VarChar(120)
  groomNameEn     String?     @db.VarChar(120)
  startsAt        DateTime // stored in UTC, shown in Asia/Phnom_Penh
  venueKm         String?     @db.VarChar(300)
  venueEn         String?     @db.VarChar(300)
  mapUrl          String?     @db.VarChar(500)
  schedule        Json        @default("[]") // [{ time, titleKm, titleEn }]
  photos          Json        @default("[]") // [{ key }] storage keys, in display order
  khqrImageKey    String?     @db.VarChar(300)
  khqrAccountName String?     @db.VarChar(120)
  templateId      String?     @db.Uuid
  helperCode      String      @unique @db.VarChar(6)
  telegramChatId  BigInt? // where host alerts go
  slug            String?     @unique @db.VarChar(60) // public ticket page /e/<slug>
  descriptionKm   String?     @db.VarChar(4000)
  descriptionEn   String?     @db.VarChar(4000)
  thankYouKm      String?     @db.VarChar(1000) // thank-you text; {name}, {gift}, {couple}, {link}
  thankYouEn      String?     @db.VarChar(1000)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  owner           User            @relation("EventOwner", fields: [ownerId], references: [id])
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  template        Template?       @relation(fields: [templateId], references: [id])
  members         EventMember[]
  guests          Guest[]
  gifts           Gift[]
  payments        Payment[]
  checkins        Checkin[]
  auditLogs       AuditLog[]
  tables          DiningTable[]
  thankYous       ThankYou[]
  ticketTypes     TicketType[]
  orders          Order[]
  tickets         Ticket[]
  vendorEnquiries VendorEnquiry[]
  eventVendors    EventVendor[]
  planOrders      PlanOrder[]
  guestPhotos     GuestPhoto[]

  @@index([ownerId])
  @@index([organizationId, startsAt])
}

model EventMember {
  id              String     @id @default(uuid()) @db.Uuid
  eventId         String     @db.Uuid
  userId          String?    @db.Uuid // empty for helpers who joined with the event's helper code
  role            MemberRole
  displayName     String     @db.VarChar(120)
  // Host access that comes from the planner organization; ends when they leave it.
  viaOrganization Boolean    @default(false)
  revokedAt       DateTime?
  createdAt       DateTime   @default(now())

  event          Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User?      @relation(fields: [userId], references: [id])
  giftsRecorded  Gift[]     @relation("GiftRecordedBy")
  giftsVoided    Gift[]     @relation("GiftVoidedBy")
  checkins       Checkin[]
  auditLogs      AuditLog[]
  ticketsScanned Ticket[]

  @@unique([eventId, userId])
  @@index([eventId])
}

model Guest {
  id           String     @id @default(uuid()) @db.Uuid
  eventId      String     @db.Uuid
  clientId     String?    @db.Uuid // set when created offline at the desk
  name         String     @db.VarChar(160)
  nameAlt      String?    @db.VarChar(160) // the name in the other script, to help search
  phone        String?    @db.VarChar(20)
  side         Side       @default(BOTH)
  group        String?    @db.VarChar(80)
  invitedCount Int        @default(1) // party size the host expects
  inviteToken  String     @unique @db.VarChar(32)
  rsvpStatus   RsvpStatus @default(PENDING)
  rsvpCount    Int? // people the guest confirmed
  rsvpMessage  String?    @db.VarChar(500)
  rsvpAt       DateTime?
  openedAt     DateTime? // first time the invitation was opened
  tableId      String?    @db.Uuid
  walkIn       Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  table     DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  gifts     Gift[]
  checkins  Checkin[]
  thankYous ThankYou[]
  photos    GuestPhoto[]

  @@unique([eventId, clientId])
  @@index([eventId, tableId])
  @@index([eventId, side])
  @@index([eventId, name])
}

model Gift {
  id           String     @id @default(uuid()) @db.Uuid
  eventId      String     @db.Uuid
  clientId     String?    @db.Uuid // idempotency key from the offline desk
  guestId      String?    @db.Uuid
  giverName    String?    @db.VarChar(160) // when the giver is not on the guest list
  amount       Int // USD cents or KHR riel, always > 0
  currency     Currency
  method       GiftMethod
  status       GiftStatus @default(CONFIRMED) // gifts a guest submits start PENDING
  source       GiftSource
  note         String?    @db.VarChar(500)
  recordedById String?    @db.Uuid // empty when a guest submitted it
  recordedAt   DateTime   @default(now()) // device time at the desk
  confirmedAt  DateTime?
  voidedAt     DateTime?
  voidedById   String?    @db.Uuid
  voidReason   String?    @db.VarChar(300)
  paymentId    String?    @unique @db.Uuid
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  event      Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest      Guest?       @relation(fields: [guestId], references: [id])
  recordedBy EventMember? @relation("GiftRecordedBy", fields: [recordedById], references: [id])
  voidedBy   EventMember? @relation("GiftVoidedBy", fields: [voidedById], references: [id])
  payment    Payment?     @relation(fields: [paymentId], references: [id])

  @@unique([eventId, clientId])
  @@index([eventId, status])
  @@index([eventId, guestId])
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  eventId         String?       @db.Uuid // empty for payments to the platform not tied to an event
  provider        String        @db.VarChar(40) // "manual", "bakong", ...
  reference       String        @db.VarChar(120)
  amount          Int
  currency        Currency
  status          PaymentStatus @default(PENDING)
  providerPayload Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  event     Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  gift      Gift?
  order     Order?
  planOrder PlanOrder?

  @@unique([provider, reference])
  @@index([eventId, status])
}

model Checkin {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @db.Uuid
  guestId       String   @db.Uuid
  clientId      String?  @db.Uuid
  peopleCount   Int      @default(1)
  checkedInById String   @db.Uuid
  checkedInAt   DateTime @default(now())

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest       Guest       @relation(fields: [guestId], references: [id], onDelete: Cascade)
  checkedInBy EventMember @relation(fields: [checkedInById], references: [id])

  @@unique([eventId, guestId]) // one check-in per guest
  @@unique([eventId, clientId])
}

model Template {
  id         String        @id @default(uuid()) @db.Uuid
  slug       String        @unique @db.VarChar(60)
  name       String        @db.VarChar(120)
  style      TemplateStyle
  previewUrl String?       @db.VarChar(500)
  config     Json // colors, fonts, layout options
  isActive   Boolean       @default(true)

  events Event[]
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  entity    String   @db.VarChar(40) // gift, guest, checkin, event, member
  entityId  String   @db.Uuid
  action    String   @db.VarChar(40) // create, update, void, confirm, reject, ...
  before    Json?
  after     Json?
  actorId   String?  @db.Uuid // EventMember; empty for a guest or the system
  createdAt DateTime @default(now())

  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor EventMember? @relation(fields: [actorId], references: [id])

  @@index([eventId, entity, entityId])
}

model DiningTable {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  name      String   @db.VarChar(40) // "1", "VIP", "តុគ្រួសារ"
  capacity  Int      @default(10)
  sortOrder Int      @default(0)
  note      String?  @db.VarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guests Guest[]

  @@unique([eventId, name])
  @@index([eventId, sortOrder])
}

enum ThankYouChannel {
  SMS
  SHARE // sent by hand (Telegram share button), marked as sent by the host
}

enum ThankYouStatus {
  QUEUED
  SENT
  FAILED
}

// One thank-you per guest per channel, so nobody is thanked twice by mistake.
model ThankYou {
  id        String          @id @default(uuid()) @db.Uuid
  eventId   String          @db.Uuid
  guestId   String          @db.Uuid
  channel   ThankYouChannel
  status    ThankYouStatus  @default(QUEUED)
  language  Language        @default(KM)
  text      String          @db.VarChar(1600)
  error     String?         @db.VarChar(300)
  sentAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([guestId, channel])
  @@index([eventId, status])
}

enum OrgRole {
  OWNER
  STAFF
}

// A wedding planner or venue running many events for clients.
model Organization {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(120)
  brandColor String    @default("#9b2c2c") @db.VarChar(7)
  logoKey    String?   @db.VarChar(300)
  paidUntil  DateTime? // planner subscription: client events can be added until then
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  members    OrganizationMember[]
  events     Event[]
  planOrders PlanOrder[]
}

model OrganizationMember {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  role           OrgRole
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
}

// Ticketed events (concerts, seminars, workshops) -------------------------------------------

model TicketType {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @db.Uuid
  name        String    @db.VarChar(80) // "VIP", "ធម្មតា", "Early bird"
  description String?   @db.VarChar(300)
  price       Int // minor units of currency
  currency    Currency
  quantity    Int // tickets for sale in total
  maxPerOrder Int       @default(10)
  salesStart  DateTime?
  salesEnd    DateTime?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items   OrderItem[]
  tickets Ticket[]

  @@index([eventId, sortOrder])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  eventId         String      @db.Uuid
  token           String      @unique @db.VarChar(32) // the buyer's private order page /o/<token>
  reference       String      @db.VarChar(12) // short code the buyer writes in the KHQR payment note
  buyerName       String      @db.VarChar(120)
  buyerPhone      String      @db.VarChar(20)
  status          OrderStatus @default(PENDING_PAYMENT)
  total           Int
  currency        Currency
  fee             Int         @default(0) // platform fee on this order, same currency
  expiresAt       DateTime // tickets are held until then
  paidAt          DateTime?
  cancelledReason String?     @db.VarChar(300)
  paymentId       String?     @unique @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payment Payment?    @relation(fields: [paymentId], references: [id])
  items   OrderItem[]
  tickets Ticket[]

  @@unique([eventId, reference])
  @@index([eventId, status])
}

model OrderItem {
  id           String @id @default(uuid()) @db.Uuid
  orderId      String @db.Uuid
  ticketTypeId String @db.Uuid
  quantity     Int
  unitPrice    Int

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([ticketTypeId])
}

model Ticket {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @db.Uuid
  orderId       String    @db.Uuid
  ticketTypeId  String    @db.Uuid
  code          String    @unique @db.VarChar(32) // in the QR; unguessable
  checkedInAt   DateTime?
  checkedInById String?   @db.Uuid
  scanClientId  String?   @db.Uuid // the scanning phone's id for this entry, so a replay counts once
  createdAt     DateTime  @default(now())

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType  TicketType   @relation(fields: [ticketTypeId], references: [id])
  checkedInBy EventMember? @relation(fields: [checkedInById], references: [id])

  @@index([eventId])
}

// Vendor marketplace ------------------------------------------------------------------------

enum VendorCategory {
  PHOTOGRAPHY
  VIDEO
  DECORATION
  VENUE
  MAKEUP
  ATTIRE
  CATERING
  MUSIC
  MC
  PRINTING
  OTHER
}

enum VendorStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
}

model Vendor {
  id            String         @id @default(uuid()) @db.Uuid
  ownerId       String         @db.Uuid
  slug          String         @unique @db.VarChar(60)
  name          String         @db.VarChar(120)
  category      VendorCategory
  province      String         @db.VarChar(40) // see lib/vendors.ts PROVINCES
  descriptionKm String?        @db.VarChar(4000)
  descriptionEn String?        @db.VarChar(4000)
  priceFrom     Int? // minor units of priceCurrency
  priceCurrency Currency       @default(USD)
  phone         String?        @db.VarChar(20)
  telegram      String?        @db.VarChar(40) // username, without @
  facebookUrl   String?        @db.VarChar(300)
  logoKey       String?        @db.VarChar(300)
  photos        Json           @default("[]")
  status        VendorStatus   @default(DRAFT)
  reviewNote    String?        @db.VarChar(300) // why it was suspended or sent back
  featuredUntil DateTime? // paid placement: listed first until then
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  owner      User            @relation(fields: [ownerId], references: [id])
  enquiries  VendorEnquiry[]
  reviews    VendorReview[]
  events     EventVendor[]
  planOrders PlanOrder[]
  reports    Report[]

  @@index([status, category, province])
  @@index([ownerId])
}

model VendorEnquiry {
  id        String    @id @default(uuid()) @db.Uuid
  vendorId  String    @db.Uuid
  userId    String    @db.Uuid
  eventId   String?   @db.Uuid
  name      String    @db.VarChar(120)
  phone     String    @db.VarChar(20)
  eventDate DateTime?
  message   String    @db.VarChar(2000)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
  event  Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
  @@index([userId])
}

model VendorReview {
  id        String    @id @default(uuid()) @db.Uuid
  vendorId  String    @db.Uuid
  userId    String    @db.Uuid
  rating    Int // 1–5
  text      String?   @db.VarChar(2000)
  reply     String?   @db.VarChar(2000) // the vendor's answer
  repliedAt DateTime?
  hiddenAt  DateTime? // hidden by an admin
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  reports Report[]

  @@unique([vendorId, userId])
}

enum EventVendorStatus {
  CONSIDERING
  BOOKED
}

model EventVendor {
  id        String            @id @default(uuid()) @db.Uuid
  eventId   String            @db.Uuid
  vendorId  String            @db.Uuid
  status    EventVendorStatus @default(CONSIDERING)
  note      String?           @db.VarChar(300)
  createdAt DateTime          @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([eventId, vendorId])
}

// Paid plans ----------------------------------------------------------------------------------

enum Plan {
  FREE
  STANDARD
  PREMIUM
}

enum PlanOrderStatus {
  PENDING
  PAID
  CANCELLED
}

// A host's request to move an event to a paid plan, paid to the platform's KHQR and confirmed
// by a platform admin.
enum PlanOrderPurpose {
  EVENT_PLAN // an event moves to a paid plan
  VENDOR_FEATURED // a vendor is listed first for some days
  PLANNER_SUBSCRIPTION // a planner organization pays for some months
}

model PlanOrder {
  id             String           @id @default(uuid()) @db.Uuid
  purpose        PlanOrderPurpose @default(EVENT_PLAN)
  eventId        String?          @db.Uuid // EVENT_PLAN
  plan           Plan? // EVENT_PLAN
  vendorId       String?          @db.Uuid // VENDOR_FEATURED
  organizationId String?          @db.Uuid // PLANNER_SUBSCRIPTION
  units          Int? // days featured, or months of subscription
  amount         Int // minor units (for a plan: the new plan's price less what the event already paid)
  currency       Currency         @default(USD)
  reference      String           @unique @db.VarChar(12) // written in the payment note
  status         PlanOrderStatus  @default(PENDING)
  requestedById  String?          @db.Uuid // EventMember, for event plans
  userId         String?          @db.Uuid // who asked (User)
  confirmedById  String?          @db.Uuid // the admin (User)
  paymentId      String?          @unique @db.Uuid
  paidAt         DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())

  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor       Vendor?       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment?      @relation(fields: [paymentId], references: [id])

  @@index([status, createdAt])
  @@index([eventId])
  @@index([vendorId])
  @@index([organizationId])
}

// Someone flags a vendor listing or a review for the platform admins to look at.
enum ReportReason {
  FAKE
  INAPPROPRIATE
  SPAM
  OTHER
}

model Report {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  vendorId     String       @db.Uuid
  reviewId     String?      @db.Uuid // empty: about the vendor itself
  reason       ReportReason
  note         String?      @db.VarChar(500)
  resolvedAt   DateTime?
  resolvedById String?      @db.Uuid
  createdAt    DateTime     @default(now())

  user   User          @relation(fields: [userId], references: [id])
  vendor Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  review VendorReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, createdAt])
}

// Photo wall: photos guests take on the day, sent from their invitation link.
model GuestPhoto {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @db.Uuid
  guestId   String    @db.Uuid
  key       String    @db.VarChar(300)
  hiddenAt  DateTime? // hidden by a host
  createdAt DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([guestId])
}
